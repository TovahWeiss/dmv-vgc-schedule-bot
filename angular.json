{
  "$schema": "./node_modules/@angular/cli/lib/config/schema.json",
  "version": 1,
  "newProjectRoot": "projects",
  "projects": {
    "message-config-editor": {
      "projectType": "application",
      "root": "web",
      "sourceRoot": "web/src",
      "prefix": "app",
      "architect": {
        "build": {
          "builder": "@angular/build:application",
          "options": {
            "outputPath": "dist/web",
            "index": "web/src/index.html",
            "browser": "web/src/main.ts",
            "polyfills": [
              "zone.js"
            ],
            "tsConfig": "web/tsconfig.app.json",
            "assets": [],
            "styles": [
              "web/src/styles.css"
            ]
          },
          "configurations": {
            "production": {
              "budgets": [
                {
                  "type": "initial",
                  "maximumWarning": "600kB",
                  "maximumError": "1MB"
                },
                {
                  "type": "anyComponentStyle",
                  "maximumWarning": "8kB",
                  "maximumError": "12kB"
                }
              ],
              "outputHashing": "all"
            },
            "development": {
              "optimization": false,
              "extractLicenses": false,
              "sourceMap": true
            }
          },
          "defaultConfiguration": "production"
        },
        "serve": {
          "builder": "@angular/build:dev-server",
          "configurations": {
            "production": {
              "buildTarget": "message-config-editor:build:production"
            },
            "development": {
              "buildTarget": "message-config-editor:build:development"
            }
          },
          "defaultConfiguration": "development"
        }
      }
    }
  }
}
