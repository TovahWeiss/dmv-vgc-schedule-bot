{
  "name": "dmv-vgc-message-config-editor",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "node dist/server/index.js",
    "dev": "concurrently \"tsx watch server/index.ts\" \"ng serve --proxy-config proxy.conf.json\"",
    "build": "npm run build:server && ng build --configuration production",
    "build:server": "tsc -p tsconfig.server.json"
  },
  "dependencies": {
    "@angular/common": "^21.0.0",
    "@angular/compiler": "^21.0.0",
    "@angular/core": "^21.0.0",
    "@angular/forms": "^21.0.0",
    "@angular/platform-browser": "^21.0.0",
    "cookie-session": "^2.1.0",
    "discord.js": "^14.28.1",
    "dotenv": "^16.4.7",
    "express": "^5.1.0",
    "lossless-json": "^4.2.0",
    "rxjs": "~7.8.2",
    "tslib": "^2.8.1",
    "zone.js": "~0.15.1"
  },
  "devDependencies": {
    "@angular/build": "^21.0.0",
    "@angular/cli": "^22.2.6",
    "@types/cookie-session": "^2.0.49",
    "@types/express": "^5.0.3",
    "@types/node": "^24.0.0",
    "concurrently": "^9.2.1",
    "tsx": "^4.20.3",
    "typescript": "~5.9.2"
  },
  "engines": {
    "node": ">=20.19.0"
  },
  "allowScripts": {
    "@parcel/watcher@2.6.0": true,
    "esbuild@0.28.1": true,
    "lmdb@3.5.1": true,
    "msgpackr-extract@3.0.7": true
  }
}
